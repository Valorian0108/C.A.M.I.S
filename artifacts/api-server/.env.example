# Server Configuration
PORT=5000
NODE_ENV=development

# Qwen API Configuration
BITGET_QWEN_API_KEY=your_qwen_api_key_here
BITGET_QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
BITGET_QWEN_MODEL=qwen3.8-max

# Alpaca API Configuration (optional - will use mock data if not provided)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_BASE_URL=https://data.alpaca.markets/v1

# Bitget API Configuration (optional - will use mock data if not provided)
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here
BITGET_BASE_URL=https://api.bitget.com

